# DBARS (Demand Based Bus Allocation & Routing System) - Backend Configuration Example

# Dataset paths
DATASET_PATH=../dataset/routes_cleaned.csv
STOP_COORDINATES_PATH=../dataset/stops_cleaned.csv
METRO_DATASET_PATH=../dataset/bengaluru_metro_network.csv
FARES_DATASET_PATH=../dataset/fares.json
METRO_PDF_PATH=../dataset/Metro_Map_2025_-_Bengaluru_City.pdf
ARTIFACT_DIR=./artifacts

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017

# Security Keys
JWT_SECRET_KEY=change-this-in-production-secret-key-32chars
PASS_VERIFICATION_SECRET=change-this-pass-verification-secret

# Google Maps API (optional)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_DISTANCE_MODE=driving
GOOGLE_MAPS_LOCATION_SUFFIX=Bengaluru, Karnataka, India
GOOGLE_MAPS_MAX_REMOTE_LOOKUPS=24

# Security & Network
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY_HEADERS=false

# Admin Seeding
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_DEPOT_PASSWORD=depot123
